@startuml
title One question (MVP, local)

actor PT
participant "main.py" as CLI
participant "Input Guardrail" as G
participant "Retriever" as R
participant "Answer Generator" as A
participant "Gemini API" as M <<external>>
participant "Answer Verifier" as V
participant "Logger" as L

PT -> CLI : type question
CLI -> G : check(question)

alt SSN, EIN or name found
  G --> CLI : blocked
  CLI --> PT : "Remove names and ID numbers"
else allowed
  CLI -> R : retrieve(question)
  alt best score below threshold
    R --> CLI : no result
    CLI --> PT : "Not covered, ask your supervisor"
  else evidence found
    R --> CLI : passages + sources + year
    CLI -> A : answer(question, passages)
    A -> M : prompt
    M --> A : draft answer
    A --> CLI : draft
    CLI -> V : verify(quotes, passages)
    alt quotes not found
      V --> CLI : failed
      CLI -> A : retry once
      A --> CLI : new draft
      CLI -> V : verify again
      alt still failed
        V --> CLI : failed
        CLI --> PT : show source passages only
      else verified
        V --> CLI : ok
        CLI --> PT : answer + sources + year
      end
    else verified
      V --> CLI : ok
      CLI --> PT : answer + sources + year
    end
  end
end

CLI -> L : log(question, passages, outcome)

opt PT gives feedback
  PT -> CLI : y / n
  CLI -> L : log(feedback)
end
@enduml
