flowchart TD
  A(["PT types a question<br/>on the Streamlit page"]) --> B{"Has a name,<br/>SSN or EIN?"}
  B -- Yes --> B1["Show a warning and stop"]
  B -- No --> C["Search the office documents"]
  C --> D{"Found good<br/>matching passages?"}
  D -- No --> D1["Say: Not covered,<br/>ask your supervisor"]
  D -- Yes --> E["AI writes the answer<br/>using only those passages"]
  E --> F{"Do the quotes match<br/>the documents?"}
  F -- No --> F1["Show the original<br/>passages only"]
  F -- Yes --> G["Show answer,<br/>sources and year"]
  G --> H(["PT checks the quotes<br/>and clicks helpful or not"])
  H --> I[("Save to log")]
  I -.-> J(["Owner reviews the log<br/>and feedback"])
  K[["Run the 39 test questions<br/>before the demo"]] -.-> A

  classDef human fill:#fff3e0,stroke:#e65100,color:#000
  classDef test fill:#e8f5e9,stroke:#2e7d32,color:#000
  class H,J human
  class K test
