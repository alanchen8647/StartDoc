flowchart TD
  subgraph IN["INPUT"]
    U(["User picks a mode and<br/>types a question<br/>main.py"])
    D[("docs/ folder<br/>4 sample .md files")]
  end
  subgraph PROC["PROCESS"]
    L["Load, split and index<br/>the documents<br/>DocuBot"]
    R["Retriever<br/>score the chunks, keep the best<br/>DocuBot.retrieve"]
    T{"Best score above<br/>the threshold?"}
    G["Generator<br/>Gemini writes the answer<br/>llm_client.py"]
  end
  subgraph OUT["OUTPUT"]
    O1["Print the snippets<br/>retrieval only mode"]
    O2["Print the answer<br/>RAG mode"]
    O3["Print: I do not know"]
  end
  subgraph CHECK["CHECKING"]
    H(["Human: user reads the<br/>output and judges it"])
    E[["Test: evaluation.py<br/>retrieval hit rate"]]
  end

  D --> L --> R
  U --> R
  R --> T
  T -- "No" --> O3
  T -- "Yes, retrieval only" --> O1
  T -- "Yes, RAG" --> G --> O2
  O1 --> H
  O2 --> H
  O3 --> H
  E -.-> R

  style IN fill:#fafafa,stroke:#bdbdbd
