flowchart LR
  pt(["Actor: PT"])
  owner(["Actor: Office owner"])
  sup(["Actor: Supervisor"])

  subgraph OFF["Offline preparation"]
    src["«artifact»<br/>Source files<br/>.docx / .pdf / .md"]
    prep["«component»<br/>Document Preparer<br/>prepare_docs.py"]
    kb[("«database»<br/>Knowledge Base<br/>docs_pt/ + manifest.json")]
  end

  subgraph RUN["Runtime (one question)"]
    cli["«component»<br/>Command-line app<br/>main.py"]
    guard["«component»<br/>Input Guardrail"]
    ret["«component»<br/>Retriever + Confidence Check<br/>docubot.py"]
    gen["«component»<br/>Answer Generator<br/>llm_client.py"]
    ver["«component»<br/>Answer Verifier"]
    logger["«component»<br/>Logger"]
  end

  logfile[("«database»<br/>Log file")]
  gem{{"«external»<br/>Gemini API"}}

  subgraph EVAL["Evaluation"]
    tests["«artifact»<br/>Test Set<br/>39 questions"]
    evaluator["«component»<br/>Evaluator<br/>evaluation.py"]
  end

  src -->|"A1 read"| prep
  prep -->|"A2 write"| kb
  kb -->|"A3 load at start"| ret
  pt -->|"1 question"| cli
  cli -->|"2 check"| guard
  guard -->|"3 allowed question"| ret
  ret -->|"4 question + passages"| gen
  gen -->|"5 prompt"| gem
  gen -->|"6 draft + quotes"| ver
  ver -->|"7 answer + sources + year"| cli
  cli -->|"8 shown in terminal"| pt
  cli -.->|"9 log"| logger
  logger --> logfile
  owner -.->|"H1 review rules"| prep
  pt -.->|"H2 check quotes<br/>H4 feedback y/n"| cli
  cli -.->|"H3 not covered:<br/>ask supervisor"| sup
  owner -.->|"H4 review feedback"| logfile
  tests --> evaluator
  evaluator -.->|"T2 run test questions"| cli
  evaluator -.->|"report"| owner

  classDef human fill:#fff3e0,stroke:#e65100,color:#000
  classDef auto fill:#e8f5e9,stroke:#2e7d32,color:#000
  classDef ext fill:#ede7f6,stroke:#4527a0,color:#000
  class pt,owner,sup human
  class tests,evaluator auto
  class gem ext
  linkStyle 13,14,15,16 stroke:#e65100,stroke-width:2px
  linkStyle 18,19 stroke:#2e7d32,stroke-width:2px
